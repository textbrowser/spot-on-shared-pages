        <h1>
            <span data-component-id="plus2025:field_inline" class="field field--name-title field--type-string field--label-hidden">Dark stars</span>


        </h1>
        

                              <div class="field field--name-field-subtitle field--type-string field--label-hidden field__item">New theories shed light on black holes</div>
            
      
                        <footer class="node__meta">
            
                        <div class="node__submitted tell">
              
                                            <div class="field field--name-field-authors field--type-entity-reference field--label-hidden field__items">
                  <div class="field__item"><a href="/people/marianne-freiberger" hreflang="en">Marianne Freiberger</a></div>
              </div>
      
              
                <span data-component-id="plus2025:field_inline" class="field field--name-created field--type-created field--label-hidden"><time datetime="2026-02-26T15:53:11+00:00" title="Thursday, February 26, 2026 - 15:53" data-component-id="plus2025:time" class="datetime">26  February,  2026</time>
</span>


                            
              
            </div>
          </footer>
