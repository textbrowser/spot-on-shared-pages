<tr>
  <td><em>n</em></td>
  <td>truth value of <em>L</em> in \(\langle \mathcal{M}_0,\tau^n
(\varnothing)\rangle\)</td> </tr>
<tr>
  <td>0</td>
  <td>true</td> </tr>
<tr>
  <td>1</td>
